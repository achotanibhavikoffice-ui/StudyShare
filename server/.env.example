PORT=5000
CLIENT_URL=http://localhost:5173

# Leave MONGO_URI empty to use a temporary in-memory database (auto-seeded with mock data).
# Atlas: mongodb+srv://<user>:<url-encoded-password>@<cluster>.mongodb.net/studyshare?retryWrites=true&w=majority
MONGO_URI=
AUTO_SEED=false

# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string

# Leave empty to store files locally in server/uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
